# Copy to .env and fill in. .env is gitignored and must never be committed.

# Contact address sent with every NCBI E-utilities request (NCBI requires this).
NCBI_EMAIL=

# Free from https://www.ncbi.nlm.nih.gov/account/settings/
# Raises the E-utilities rate limit from 3 to 10 requests/second.
NCBI_API_KEY=

# Tool name sent with E-utilities requests.
NCBI_TOOL=elixir-expert-discovery
